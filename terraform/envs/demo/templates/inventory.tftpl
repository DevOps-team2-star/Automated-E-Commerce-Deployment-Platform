# Generated by Terraform (terraform/envs/demo) - do not edit by hand.
[server]
k3s-server ansible_host=${server}

[agents]
%{ for i, ip in agents ~}
k3s-agent-${i + 1} ansible_host=${ip}
%{ endfor ~}

[k3s:children]
server
agents

[k3s:vars]
ansible_user=${ssh_user}
ansible_ssh_private_key_file=${ssh_private_key}
ansible_ssh_common_args='-o StrictHostKeyChecking=accept-new'
